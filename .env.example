# ============================================================================
# Ensemble Theorem Prover - Environment Configuration Example
# ============================================================================
# Copy this file to .env and fill in local secrets there.
# .env is ignored and must not be committed.

# --- Cloud LLM API Keys ---
# mini_prover reads the provider-specific key for the selected provider.
# For OpenRouter, also pass an explicit --prover-model / --refiner-model.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
